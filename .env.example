# DTC245180035 - Blog/CMS Environment Variables Template
NODE_ENV=production
PORT=3000

# Database Configuration
POSTGRES_DB=blogcms
POSTGRES_USER=blogcms_app
POSTGRES_PASSWORD=replace_with_strong_password_min_20_chars
POSTGRES_PORT=5432
DATABASE_URL=postgres://blogcms_app:replace_with_strong_password_min_20_chars@db:5432/blogcms

# Session Secret
SESSION_SECRET=replace_with_random_secret_min_20_chars

# Admin Seed Account
ADMIN_EMAIL=admin@blogcms.local
ADMIN_PASSWORD=replace_with_admin_password_min_20_chars

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=pgadmin@blogcms.local
PGADMIN_DEFAULT_PASSWORD=replace_with_pgadmin_password_min_20_chars

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_password_min_20_chars

# Seed Accounts Passwords
SEED_ADMIN_PASSWORD=replace_with_seed_admin_password
SEED_AUTHOR_PASSWORD=replace_with_seed_author_password
SEED_MEMBER_PASSWORD=replace_with_seed_member_password
POSTGRES_EXPORTER_PASSWORD=replace_with_exporter_password_min_20_chars
