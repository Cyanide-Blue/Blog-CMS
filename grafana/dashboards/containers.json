          "expr": "sum(rate(container_network_transmit_bytes_total[1m])) by (instance)",
          "legendFormat": "{{instance}} tx",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "Bps"
        }
      }
    }
