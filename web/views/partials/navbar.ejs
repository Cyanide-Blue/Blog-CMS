<header class="site-header">
  <div class="container header-container">
    <a href="/" class="site-logo">
      <span class="logo-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </span>
      <span class="logo-text">
        <span class="logo-title">DTC<strong>Blog</strong></span>
        <span class="logo-sub">DEVOPS ARCHITECTURE</span>
      </span>
    </a>

    <% const path = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <nav class="site-nav">
      <a href="/" class="nav-link <%= path === '/' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Trang chủ</span>
      </a>
      <a href="/posts" class="nav-link <%= path.startsWith('/posts') ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
        <span>Bài viết</span>
      </a>
      <a href="/rss.xml" target="_blank" class="nav-link rss-link" title="Đăng ký RSS Feed">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
        <span>RSS</span>
      </a>

      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <% if (currentUser.role === 'author' || currentUser.role === 'admin') { %>
          <a href="/author/dashboard" class="btn-nav-chip btn-author <%= path.startsWith('/author') ? 'active' : '' %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Tác giả
          </a>
        <% } %>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/dashboard" class="btn-nav-chip btn-admin <%= path.startsWith('/admin') ? 'active' : '' %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
            Quản trị
          </a>
        <% } %>

        <div class="user-menu">
          <div class="user-profile-badge">
            <span class="user-avatar-initial"><%= (currentUser.full_name || currentUser.username).charAt(0).toUpperCase() %></span>
            <span class="user-greeting">
              <strong><%= currentUser.full_name %></strong>
              <span class="role-badge role-<%= currentUser.role %>"><%= currentUser.role.toUpperCase() %></span>
            </span>
          </div>
          <form action="/logout" method="POST" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="btn btn-outline btn-sm btn-logout" title="Đăng xuất">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              <span>Thoát</span>
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="auth-links">
          <a href="/login" class="btn btn-ghost btn-sm">Đăng nhập</a>
          <a href="/register" class="btn btn-primary btn-sm btn-glow">Đăng ký</a>
        </div>
      <% } %>
    </nav>
  </div>
</header>