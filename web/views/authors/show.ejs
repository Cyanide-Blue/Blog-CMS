<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container author-profile-page">
  <div class="author-hero card">
    <div class="author-hero-avatar"><%= author.full_name.charAt(0) %></div>
    <div class="author-hero-info">
      <h1><%= author.full_name %></h1>
      <p class="author-username">@<%= author.username %> &bull; <span class="role-badge role-<%= author.role %>"><%= author.role.toUpperCase() %></span></p>
      <p class="author-bio"><%= author.bio || 'Chưa cập nhật tiểu sử.' %></p>
      <p class="author-joined text-muted">Thành viên từ: <%= new Date(author.created_at).toLocaleDateString('vi-VN') %></p>
    </div>
  </div>

  <div class="author-posts-section">
    <h2>Bài viết của tác giả (<%= posts.length %>)</h2>

    <% if (posts.length === 0) { %>
      <div class="card empty-state p-4 text-center">
        <p class="text-muted">Tác giả chưa có bài viết xuất bản nào.</p>
      </div>
    <% } else { %>
      <div class="posts-grid">
        <% posts.forEach(post => { %>
          <article class="post-card card">
            <a href="/posts/<%= post.slug %>" class="post-cover-link">
              <img src="<%= post.cover_image_path || '/images/covers/cover-1.svg' %>" 
                   alt="<%= post.title %>" 
                   class="post-cover-img" 
                   loading="lazy"
                   onerror="this.onerror=null; this.src='/images/covers/cover-1.svg';">
              <span class="category-badge-floating"><%= post.category_name %></span>
            </a>
            <div class="post-card-body">
              <div class="post-meta">
                <span class="post-date">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  <%= new Date(post.published_at).toLocaleDateString('vi-VN') %>
                </span>
                <span class="post-views">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <%= post.view_count %> lượt xem
                </span>
              </div>
              <h3 class="post-title"><a href="/posts/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-excerpt"><%= post.excerpt %></p>
              <div class="post-card-footer">
                <span class="text-muted small">Cập nhật bởi <%= author.full_name %></span>
                <a href="/posts/<%= post.slug %>" class="read-more-btn" aria-label="Xem bài viết">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>