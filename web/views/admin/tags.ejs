<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <div class="admin-header mb-4">
    <div class="d-flex justify-between align-center mb-3">
      <div>
        <h1 class="page-title mb-1">Quản lý Thẻ (Tags)</h1>
        <p class="text-muted">Gắn nhãn từ khóa hỗ trợ tìm kiếm và liên kết chéo giữa các bài viết.</p>
      </div>
      <div>
        <a href="/admin/dashboard" class="btn btn-outline">&larr; Quay lại Dashboard</a>
      </div>
    </div>

    <!-- Admin Nav Submenu -->
    <div class="admin-nav-bar d-flex gap-2 pb-2 border-bottom">
      <a href="/admin/dashboard" class="btn btn-sm btn-outline">Dashboard</a>
      <a href="/admin/queue" class="btn btn-sm btn-outline">Hàng đợi duyệt</a>
      <a href="/admin/categories" class="btn btn-sm btn-outline">Chuyên mục</a>
      <a href="/admin/tags" class="btn btn-sm btn-primary">Thẻ (Tags)</a>
      <a href="/admin/comments" class="btn btn-sm btn-outline">Bình luận</a>
      <a href="/admin/users" class="btn btn-sm btn-outline">Tài khoản</a>
      <a href="/admin/media" class="btn btn-sm btn-outline">Media Library</a>
    </div>
  </div>

  <% if (msg) { %>
    <div class="alert alert-success mb-4"><%= msg %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger mb-4"><%= error %></div>
  <% } %>

  <div class="row">
    <!-- Form Create Tag -->
    <div class="col-md-4 mb-4">
      <div class="card p-4">
        <h3 class="card-title mb-3">Tạo thẻ (Tag) mới</h3>
        <form action="/admin/tags" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group mb-3">
            <label for="tag-name" class="form-label">Tên thẻ <span class="text-danger">*</span></label>
            <input type="text" id="tag-name" name="name" class="form-control" placeholder="ví dụ: kubernetes, microservices" required>
          </div>

          <div class="form-group mb-4">
            <label for="tag-slug" class="form-label">Slug URL (tùy chọn)</label>
            <input type="text" id="tag-slug" name="slug" class="form-control" placeholder="tự động tạo nếu để trống">
          </div>

          <button type="submit" class="btn btn-primary btn-block">Thêm thẻ mới</button>
        </form>
      </div>
    </div>

    <!-- Tags List Table -->
    <div class="col-md-8">
      <div class="card p-4">
        <h3 class="card-title mb-3">Danh sách thẻ hiện tại</h3>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 40px;">STT</th>
                <th>Tên thẻ</th>
                <th>Slug</th>
                <th class="text-center">Số bài viết gắn thẻ</th>
                <th class="text-right">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% if (tags.length === 0) { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">Chưa có thẻ nào được tạo.</td>
                </tr>
              <% } else { %>
                <% tags.forEach((t, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td>
                      <span class="tag-badge">#<%= t.name %></span>
                    </td>
                    <td><code><%= t.slug %></code></td>
                    <td class="text-center">
                      <span class="badge badge-light"><%= t.post_count %> bài</span>
                    </td>
                    <td class="text-right">
                      <form action="/admin/tags/<%= t.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Bạn có chắc muốn xóa thẻ này? Các bài viết sẽ bị gỡ liên kết thẻ tương ứng.');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>