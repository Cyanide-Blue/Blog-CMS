<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container posts-page">
  <div class="page-header">
    <h1>Khám phá Bài viết</h1>
    <p>Tổng hợp <%= totalPosts %> bài viết chất lượng về công nghệ và hạ tầng phần mềm</p>
  </div>

  <div class="filter-bar card">
    <form action="/posts" method="GET" class="filter-form">
      <div class="filter-group">
        <label for="q">Tìm kiếm:</label>
        <input type="text" id="q" name="q" value="<%= search %>" placeholder="Nhập từ khóa..." class="form-control">
      </div>

      <div class="filter-group">
        <label for="category">Chuyên mục:</label>
        <select id="category" name="category" class="form-control" onchange="this.form.submit()">
          <option value="">-- Tất cả chuyên mục --</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.slug %>" <%= categorySlug === c.slug ? 'selected' : '' %>><%= c.name %> (<%= c.post_count %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="filter-group">
        <label for="sort">Sắp xếp:</label>
        <select id="sort" name="sort" class="form-control" onchange="this.form.submit()">
          <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Mới nhất</option>
          <option value="views" <%= sort === 'views' ? 'selected' : '' %>>Xem nhiều nhất</option>
          <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Theo tiêu đề (A-Z)</option>
        </select>
      </div>

      <% if (tagSlug) { %>
        <input type="hidden" name="tag" value="<%= tagSlug %>">
      <% } %>

      <div class="filter-actions">
        <button type="submit" class="btn btn-primary">Lọc</button>
        <% if (search || categorySlug || tagSlug || sort !== 'latest') { %>
          <a href="/posts" class="btn btn-outline">Xóa lọc</a>
        <% } %>
      </div>
    </form>

    <% if (tagSlug) { %>
      <div class="active-tag-indicator">
        Đang lọc theo thẻ: <span class="tag-pill active">#<%= tagSlug %></span>
        <a href="/posts?category=<%= categorySlug %>&q=<%= search %>&sort=<%= sort %>" class="remove-tag">&times; Bỏ lọc thẻ</a>
      </div>
    <% } %>
  </div>

  <div class="layout-with-sidebar">
    <div class="main-content">
      <% if (posts.length === 0) { %>
        <div class="card empty-state">
          <h3>Không tìm thấy bài viết nào</h3>
          <p>Hãy thử tìm kiếm với từ khóa khác hoặc bỏ các bộ lọc hiện tại.</p>
          <a href="/posts" class="btn btn-primary">Xem tất cả bài viết</a>
        </div>
      <% } else { %>
        <div class="posts-list">
          <% posts.forEach(post => { %>
            <article class="post-row-card card">
              <a href="/posts/<%= post.slug %>" class="post-row-thumb">
                <img src="<%= post.cover_image_path || '/images/covers/cover-1.svg' %>" 
                     alt="<%= post.title %>" 
                     loading="lazy"
                     onerror="this.onerror=null; this.src='/images/covers/cover-1.svg';">
                <span class="category-badge-floating"><%= post.category_name %></span>
              </a>
              <div class="post-row-content">
                <div class="post-meta">
                  <span class="post-date">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <%= new Date(post.published_at).toLocaleDateString('vi-VN') %>
                  </span>
                  <span class="post-views">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <%= post.view_count %> xem
                  </span>
                </div>
                <h2 class="post-row-title"><a href="/posts/<%= post.slug %>"><%= post.title %></a></h2>
                <p class="post-row-excerpt"><%= post.excerpt %></p>
                <div class="post-row-footer">
                  <div class="post-author-info">
                    <span class="author-avatar-chip"><%= (post.author_name || 'U').charAt(0).toUpperCase() %></span>
                    <a href="/authors/<%= post.author_username %>" class="author-name"><%= post.author_name %></a>
                  </div>
                  <div class="post-tags-list">
                    <% (post.tags || []).forEach(t => { %>
                      <a href="/posts?tag=<%= t.slug %>" class="tag-small">#<%= t.name %></a>
                    <% }) %>
                  </div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (currentPage > 1) { %>
              <a href="/posts?page=<%= currentPage - 1 %>&category=<%= categorySlug %>&tag=<%= tagSlug %>&q=<%= search %>&sort=<%= sort %>" class="page-link">&laquo; Trước</a>
            <% } %>

            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="/posts?page=<%= i %>&category=<%= categorySlug %>&tag=<%= tagSlug %>&q=<%= search %>&sort=<%= sort %>" class="page-link <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="/posts?page=<%= currentPage + 1 %>&category=<%= categorySlug %>&tag=<%= tagSlug %>&q=<%= search %>&sort=<%= sort %>" class="page-link">Sau &raquo;</a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>

    <aside class="sidebar">
      <div class="sidebar-widget card">
        <div class="widget-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
          <h3>Chuyên mục</h3>
        </div>
        <ul class="widget-list">
          <% categories.forEach(cat => { %>
            <li>
              <a href="/posts?category=<%= cat.slug %>" class="category-item <%= categorySlug === cat.slug ? 'active' : '' %>">
                <span class="cat-name"><%= cat.name %></span>
                <span class="badge cat-badge"><%= cat.post_count %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="sidebar-widget card">
        <div class="widget-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
          <h3>Thẻ chủ đề</h3>
        </div>
        <div class="tags-cloud">
          <% tags.forEach(t => { %>
            <a href="/posts?tag=<%= t.slug %>" class="tag-pill <%= tagSlug === t.slug ? 'active' : '' %>">
              <span>#<%= t.name %></span>
              <span class="tag-count"><%= t.post_count %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>